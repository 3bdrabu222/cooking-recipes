<div class="container-xxl py-5">
  <!-- Header -->
  <div class="section-title mb-5">
    <h1 class="display-4 text-gradient">Random Recipe</h1>
    <p class="lead">Discover a surprise recipe!</p>
    <nav aria-label="breadcrumb" class="justify-content-center">
      <ol class="breadcrumb justify-content-center">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Random Recipe</li>
      </ol>
    </nav>
  </div>

  <!-- Random Recipe -->
  <% if(recipe != null && recipe != '') { %>
    <div class="row g-4">
      <div class="col-lg-5 animate-fade-in-up">
        <div class="card border-0 shadow-lg">
          <img src="<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.image : '/uploads/' + recipe.image %>" 
               class="card-img-top rounded-lg" 
               alt="<%= recipe.name %>" 
               style="height: 400px; object-fit: cover;">
        </div>
      </div>
      
      <div class="col-lg-7 animate-slide-in-right">
        <div class="card border-0 shadow-lg h-100">
          <div class="card-body p-4">
            <h1 class="display-5 mb-3"><%= recipe.name %></h1>
            
            <div class="d-flex align-items-center gap-3 mb-4">
              <% if(recipe.category) { %>
                <span class="badge bg-primary">
                  <i class="bi bi-tag"></i> <%= recipe.category %>
                </span>
              <% } %>
              <% if(recipe.area) { %>
                <span class="badge bg-secondary">
                  <i class="bi bi-globe"></i> <%= recipe.area %>
                </span>
              <% } %>
            </div>

            <% if(recipe.description) { %>
              <p class="lead mb-4"><%= recipe.description.substring(0, 200) %>...</p>
            <% } %>

            <div class="d-flex gap-3">
              <a href="/recipe/<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.mealDBId : recipe._id %>" class="btn btn-primary btn-lg">
                <i class="bi bi-arrow-right"></i> View Full Recipe
              </a>
              <a href="/explore-random" class="btn btn-secondary btn-lg">
                <i class="bi bi-shuffle"></i> Another Random
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <div class="card border-0 shadow-sm p-5">
        <i class="bi bi-shuffle" style="font-size: 4rem; color: var(--gray);"></i>
        <h3 class="mt-3">No Recipe Found</h3>
        <p class="text-muted">Try again to get a random recipe!</p>
        <a href="/explore-random" class="btn btn-primary mt-3">
          <i class="bi bi-arrow-clockwise"></i> Try Again
        </a>
      </div>
    </div>
  <% } %>
</div>
