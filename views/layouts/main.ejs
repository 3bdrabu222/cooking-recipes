<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title><%= typeof title != 'undefined' ? title: 'RecipeHub - Discover Amazing Recipes' %></title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <meta name="theme-color" content="#667eea">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/styles.css">
  
  <!-- Meta Tags -->
  <meta name="description" content="Discover thousands of amazing recipes from around the world. Browse by category, search, and explore delicious dishes.">
  <meta name="keywords" content="recipes, cooking, food, cuisine, dishes">
  <meta name="author" content="RecipeHub">
</head>
<body>
  
  <!-- Header -->
  <header class="navbar">
    <div class="container-xxl">
      <nav class="d-flex flex-wrap align-items-center justify-content-between py-2 py-md-3">
        <a href="/" class="navbar-brand">
          <i class="bi bi-egg-fried"></i>
          <span class="d-none d-sm-inline">RecipeHub</span>
        </a>

        <ul class="nav d-none d-lg-flex mb-0">
          <li class="nav-item">
            <a href="/" class="nav-link <%= typeof title !== 'undefined' && title.includes('Home') ? 'active' : '' %>">
              <i class="bi bi-house-door d-lg-none"></i> <span class="d-none d-xl-inline">Home</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/api-recipes" class="nav-link <%= typeof title !== 'undefined' && title.includes('API') ? 'active' : '' %>">
              <i class="bi bi-cloud d-lg-none"></i> <span class="d-none d-xl-inline">Browse</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/categories" class="nav-link <%= typeof title !== 'undefined' && title.includes('Categories') ? 'active' : '' %>">
              <i class="bi bi-grid-3x3-gap d-lg-none"></i> <span class="d-none d-xl-inline">Categories</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/explore-latest" class="nav-link <%= typeof title !== 'undefined' && title.includes('Latest') ? 'active' : '' %>">
              <i class="bi bi-clock-history d-lg-none"></i> <span class="d-none d-xl-inline">Latest</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/explore-random" class="nav-link <%= typeof title !== 'undefined' && title.includes('Random') ? 'active' : '' %>">
              <i class="bi bi-shuffle d-lg-none"></i> <span class="d-none d-xl-inline">Random</span>
            </a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2 gap-md-3">
          <form method="POST" action="/search" class="search-container d-none d-md-block">
            <i class="bi bi-search search-icon"></i>
            <input type="search" name="searchTerm" class="search-input" placeholder="Search..." aria-label="Search">
          </form>
          
          <!-- Mobile Menu Button -->
          <button class="btn btn-outline d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="Menu">
            <i class="bi bi-list"></i>
          </button>
        </div>
      </nav>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">Menu</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="nav flex-column">
        <li class="nav-item">
          <a href="/" class="nav-link">
            <i class="bi bi-house-door"></i> Home
          </a>
        </li>
        <li class="nav-item">
          <a href="/api-recipes" class="nav-link">
            <i class="bi bi-cloud"></i> Browse Recipes
          </a>
        </li>
        <li class="nav-item">
          <a href="/categories" class="nav-link">
            <i class="bi bi-grid-3x3-gap"></i> Categories
          </a>
        </li>
        <li class="nav-item">
          <a href="/explore-latest" class="nav-link">
            <i class="bi bi-clock-history"></i> Latest
          </a>
        </li>
        <li class="nav-item">
          <a href="/explore-random" class="nav-link">
            <i class="bi bi-shuffle"></i> Random
          </a>
        </li>
        <li class="nav-item">
          <a href="/about" class="nav-link">
            <i class="bi bi-info-circle"></i> About
          </a>
        </li>
      </ul>
      
      <form method="POST" action="/search" class="mt-4">
        <div class="search-container">
          <i class="bi bi-search search-icon"></i>
          <input type="search" name="searchTerm" class="search-input" placeholder="Search recipes..." aria-label="Search">
        </div>
      </form>
    </div>
  </div>

  <!-- Main Content -->
  <main>
    <%- body -%>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container-xxl">
      <div class="row g-4">
        <div class="col-md-4">
          <h3>
            <i class="bi bi-egg-fried"></i> RecipeHub
          </h3>
          <p>Discover thousands of amazing recipes from around the world. Powered by TheMealDB API.</p>
          <div class="d-flex gap-3 mt-3">
            <a href="#" class="text-decoration-none"><i class="bi bi-facebook"></i></a>
            <a href="#" class="text-decoration-none"><i class="bi bi-twitter"></i></a>
            <a href="#" class="text-decoration-none"><i class="bi bi-instagram"></i></a>
            <a href="#" class="text-decoration-none"><i class="bi bi-youtube"></i></a>
          </div>
        </div>
        <div class="col-md-4">
          <h3>Quick Links</h3>
          <ul class="list-unstyled">
            <li><a href="/"><i class="bi bi-chevron-right"></i> Home</a></li>
            <li><a href="/api-recipes"><i class="bi bi-chevron-right"></i> Browse Recipes</a></li>
            <li><a href="/categories"><i class="bi bi-chevron-right"></i> Categories</a></li>
            <li><a href="/explore-latest"><i class="bi bi-chevron-right"></i> Latest Recipes</a></li>
            <li><a href="/explore-random"><i class="bi bi-chevron-right"></i> Random Recipe</a></li>
          </ul>
        </div>
        <div class="col-md-4">
          <h3>About</h3>
          <ul class="list-unstyled">
            <li><a href="/about"><i class="bi bi-chevron-right"></i> About Us</a></li>
            <li><a href="/contact"><i class="bi bi-chevron-right"></i> Contact</a></li>
            <li><a href="https://www.themealdb.com" target="_blank"><i class="bi bi-chevron-right"></i> TheMealDB API</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; 2024 RecipeHub. All rights reserved. Powered by <a href="https://www.themealdb.com" target="_blank">TheMealDB</a></p>
      </div>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  
  <!-- Custom JS -->
  <script src="/js/script.js"></script>
</body>
</html>
