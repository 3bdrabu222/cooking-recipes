<div class="container-xxl py-5">
  <!-- Header -->
  <div class="section-title mb-5">
    <h1 class="display-4 text-gradient">
      <% if(typeof categoryName !== 'undefined' && categoryName) { %>
        <%= categoryName %> Recipes
      <% } else { %>
        Recipe Categories
      <% } %>
    </h1>
    <nav aria-label="breadcrumb" class="justify-content-center">
      <ol class="breadcrumb justify-content-center">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/categories">Categories</a></li>
        <% if(typeof categoryName !== 'undefined' && categoryName) { %>
          <li class="breadcrumb-item active" aria-current="page"><%= categoryName %></li>
        <% } %>
      </ol>
    </nav>
  </div>

  <!-- Categories Grid -->
  <% if(typeof categories !== 'undefined' && categories.length > 0) { %>
    <div class="section-title mb-4">
      <h2>Browse by Category</h2>
      <p>Select a category to explore recipes</p>
    </div>
    <div class="category-grid">
      <% categories.forEach(function(category, index) { %>
        <a href="/categories/<%- category.name %>" class="category-item animate-fade-in" style="animation-delay: <%= index * 0.1 %>s;">
          <div class="category-icon">
            <img src="<%= typeof fromAPI !== 'undefined' && fromAPI ? category.image : '/img/' + category.image %>" alt="<%- category.name %>" loading="lazy">
          </div>
          <h3><%- category.name %></h3>
          <% if(category.description) { %>
            <p class="small text-muted mt-2"><%= category.description.substring(0, 80) %>...</p>
          <% } %>
        </a>
      <% }) %>
    </div>
  <% } %>

  <!-- Recipes Grid -->
  <% if(typeof categoryById !== 'undefined' && categoryById.length > 0) { %>
    <div class="section-title mt-5 mb-4">
      <h2><%= categoryName %> Recipes</h2>
      <p>Discover delicious <%= categoryName.toLowerCase() %> recipes</p>
    </div>
    
    <div class="row g-4">
      <% categoryById.forEach(function(recipe, index){ %>
        <div class="col-md-6 col-lg-4 animate-fade-in-up" style="animation-delay: <%= index * 0.1 %>s;">
          <div class="recipe-card">
            <div class="recipe-image">
              <img src="<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.image : '/uploads/' + recipe.image %>" alt="<%= recipe.name %>" loading="lazy">
            </div>
            <div class="recipe-content">
              <h3 class="recipe-title"><%= recipe.name %></h3>
              <a href="/recipe/<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.mealDBId : recipe._id %>" class="btn btn-primary w-100 mt-3">
                <i class="bi bi-arrow-right"></i> View Recipe
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else if(typeof categoryById !== 'undefined') { %>
    <div class="text-center py-5">
      <div class="card border-0 shadow-sm p-5">
        <i class="bi bi-inbox" style="font-size: 4rem; color: var(--gray);"></i>
        <h3 class="mt-3">No Recipes Found</h3>
        <p class="text-muted">There are no recipes in this category yet.</p>
        <a href="/categories" class="btn btn-primary mt-3">
          <i class="bi bi-arrow-left"></i> Browse Other Categories
        </a>
      </div>
    </div>
  <% } %>
</div>
