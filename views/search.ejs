<div class="container-xxl py-5">
  <!-- Header -->
  <div class="section-title mb-5">
    <h1 class="display-4 text-gradient">Search Results</h1>
    <nav aria-label="breadcrumb" class="justify-content-center">
      <ol class="breadcrumb justify-content-center">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Search</li>
      </ol>
    </nav>
  </div>

  <!-- Search Form -->
  <div class="row justify-content-center mb-5">
    <div class="col-md-8">
      <form method="POST" action="/search" class="card p-4 border-0 shadow-sm">
        <div class="search-container">
          <i class="bi bi-search search-icon"></i>
          <input type="search" 
                 name="searchTerm" 
                 class="search-input" 
                 placeholder="Search for recipes..." 
                 value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>"
                 aria-label="Search">
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-3">
          <i class="bi bi-search"></i> Search Recipes
        </button>
      </form>
    </div>
  </div>

  <!-- Search Results -->
  <% if(typeof searchTerm !== 'undefined' && searchTerm) { %>
    <div class="mb-4">
      <h3>Results for: "<strong><%= searchTerm %></strong>"</h3>
      <p class="text-muted">Found <%= typeof recipe !== 'undefined' && recipe.length ? recipe.length : 0 %> recipe(s)</p>
    </div>
  <% } %>

  <!-- Recipes Grid -->
  <% if(typeof recipe !== 'undefined' && recipe.length > 0) { %>
    <div class="row g-4">
      <% recipe.forEach(function(recipe, index){ %>
        <div class="col-md-6 col-lg-4 animate-fade-in-up" style="animation-delay: <%= index * 0.1 %>s;">
          <div class="recipe-card">
            <div class="recipe-image">
              <img src="<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.image : '/uploads/' + recipe.image %>" alt="<%= recipe.name %>" loading="lazy">
            </div>
            <div class="recipe-content">
              <h3 class="recipe-title"><%= recipe.name %></h3>
              <div class="recipe-meta">
                <% if(recipe.category) { %>
                  <span><i class="bi bi-tag"></i> <%= recipe.category %></span>
                <% } %>
                <% if(recipe.area) { %>
                  <span><i class="bi bi-globe"></i> <%= recipe.area %></span>
                <% } %>
              </div>
              <a href="/recipe/<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.mealDBId : recipe._id %>" class="btn btn-primary w-100 mt-3">
                <i class="bi bi-arrow-right"></i> View Recipe
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <div class="card border-0 shadow-sm p-5">
        <i class="bi bi-search" style="font-size: 4rem; color: var(--gray);"></i>
        <h3 class="mt-3">No Recipes Found</h3>
        <p class="text-muted">
          <% if(typeof searchTerm !== 'undefined' && searchTerm) { %>
            We couldn't find any recipes matching "<strong><%= searchTerm %></strong>". Try a different search term.
          <% } else { %>
            Start searching for recipes above.
          <% } %>
        </p>
        <div class="mt-4">
          <a href="/api-recipes" class="btn btn-primary me-2">
            <i class="bi bi-cloud"></i> Browse All Recipes
          </a>
          <a href="/explore-random" class="btn btn-secondary">
            <i class="bi bi-shuffle"></i> Get Random Recipe
          </a>
        </div>
      </div>
    </div>
  <% } %>
</div>
