<div class="container-xxl py-5">
  <!-- Header -->
  <div class="section-title mb-5">
    <h1 class="display-4 text-gradient">Latest Recipes</h1>
    <p class="lead">Discover the latest recipes from our collection</p>
    <nav aria-label="breadcrumb" class="justify-content-center">
      <ol class="breadcrumb justify-content-center">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Latest Recipes</li>
      </ol>
    </nav>
  </div>

  <!-- Recipes Grid -->
  <% if(typeof recipe !== 'undefined' && recipe.length > 0) { %>
    <div class="row g-4">
      <% recipe.forEach(function(recipe, index){ %>
        <div class="col-md-6 col-lg-4 animate-fade-in-up" style="animation-delay: <%= index * 0.1 %>s;">
          <div class="recipe-card">
            <div class="recipe-image">
              <img src="<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.image : '/uploads/' + recipe.image %>" alt="<%= recipe.name %>" loading="lazy">
            </div>
            <div class="recipe-content">
              <h3 class="recipe-title"><%= recipe.name %></h3>
              <div class="recipe-meta">
                <% if(recipe.category) { %>
                  <span><i class="bi bi-tag"></i> <%= recipe.category %></span>
                <% } %>
                <% if(recipe.area) { %>
                  <span><i class="bi bi-globe"></i> <%= recipe.area %></span>
                <% } %>
              </div>
              <a href="/recipe/<%= typeof fromAPI !== 'undefined' && fromAPI ? recipe.mealDBId : recipe._id %>" class="btn btn-primary w-100 mt-3">
                <i class="bi bi-arrow-right"></i> View Recipe
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    
    <!-- Load More Button -->
    <div class="text-center mt-5">
      <a href="/api-recipes/random" class="btn btn-secondary btn-lg">
        <i class="bi bi-shuffle"></i> Get More Random Recipes
      </a>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <div class="card border-0 shadow-sm p-5">
        <i class="bi bi-clock-history" style="font-size: 4rem; color: var(--gray);"></i>
        <h3 class="mt-3">No Recipes Found</h3>
        <p class="text-muted">Check back soon for new recipes!</p>
        <a href="/api-recipes" class="btn btn-primary mt-3">
          <i class="bi bi-cloud"></i> Browse All Recipes
        </a>
      </div>
    </div>
  <% } %>
</div>
