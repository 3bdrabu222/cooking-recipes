<% if(recipe != null ) { %>

  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/api-recipes">API Recipes</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%- recipe.name %></li>
    </ol>
  </nav>

  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info d-flex align-items-center">
        <i class="bi bi-info-circle me-2"></i>
        <span>This recipe is from TheMealDB API</span>
        <% if(recipe.youtube) { %>
          <a href="<%= recipe.youtube %>" target="_blank" class="btn btn-sm btn-danger ms-auto">
            <i class="bi bi-youtube"></i> Watch on YouTube
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12 col-md-4">
      <img src="<%- recipe.image %>" class="img-fluid sticky-top rounded shadow" style="top: 20px;" alt="<%- recipe.name %>" loading="lazy">
      
      <!-- Import to Database Button -->
      <div class="mt-4">
        <form method="POST" action="/api-recipes/import/<%= recipe.mealDBId %>">
          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-download"></i> Import to Local Database
          </button>
        </form>
      </div>

      <!-- Additional Info -->
      <% if(recipe.area || recipe.tags) { %>
        <div class="card mt-3">
          <div class="card-body">
            <% if(recipe.area) { %>
              <p class="mb-2">
                <strong><i class="bi bi-globe"></i> Cuisine:</strong> <%= recipe.area %>
              </p>
            <% } %>
            <% if(recipe.category) { %>
              <p class="mb-2">
                <strong><i class="bi bi-tag"></i> Category:</strong> <%= recipe.category %>
              </p>
            <% } %>
            <% if(recipe.tags && recipe.tags.length > 0) { %>
              <p class="mb-2">
                <strong><i class="bi bi-bookmark"></i> Tags:</strong>
                <% recipe.tags.forEach(function(tag, index) { %>
                  <span class="badge bg-secondary"><%= tag.trim() %></span>
                <% }) %>
              </p>
            <% } %>
            <% if(recipe.source) { %>
              <p class="mb-0">
                <a href="<%= recipe.source %>" target="_blank" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-link-45deg"></i> View Source
                </a>
              </p>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="col-12 col-md-8">
      <div class="row">
        <div class="col-12">
          <h1 class="display-4 mb-3"><%- recipe.name %></h1>
        </div>
        
        <div class="col-12 mb-4">
          <div class="card">
            <div class="card-body">
              <h4 class="card-title">Cooking Instructions</h4>
              <div style="white-space: pre-line; line-height: 1.8;">
                <%- recipe.description %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row pt-4">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <h4 class="card-title mb-3">Ingredients</h4>
              <ul class="list-group list-group-flush">
                <% recipe.ingredients.forEach(function(ingredient, index){ %>
                  <li class="list-group-item">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <%= ingredient %>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

<% } else { %>
  <div class="alert alert-danger">
    <h4>Recipe not found</h4>
    <p>The recipe you're looking for doesn't exist.</p>
    <a href="/api-recipes" class="btn btn-primary">Browse Recipes</a>
  </div>
<% } %>

